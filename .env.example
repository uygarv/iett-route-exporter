TOMTOM_API_KEY=
HERE_API_KEY=
HERE_REQUESTS_PER_SECOND=2
HERE_MAX_CONCURRENCY=2
JOURNEY_MAX_CONCURRENCY=8
TOMTOM_REQUESTS_PER_SECOND=4
TOMTOM_MAX_CONCURRENCY=4

# Dynamic Turkish HTTP/HTTPS proxies for IBB/IETT route and archive requests.
# Discovery is cached for 10 minutes. Each client can bypass it independently.
IBB_PROXY_SOURCE_URL=https://api.proxyscrape.com/v4/free-proxy-list/get?request=display_proxies&proxy_format=protocolipport&format=json&country=tr
# true requires a source URL; false uses direct access without proxy discovery.
# If unset/blank, a configured source URL enables proxy use (legacy behavior).
IETT_CLIENT_USE_PROXY=true
IETT_ARCHIVE_USE_PROXY=true
# TCP/TLS connection and response-header deadlines (direct or proxy IETT access).
IBB_CONNECT_TIMEOUT_MS=5000
IBB_HEADERS_TIMEOUT_MS=15000

# Optional history storage. Importing the app/library does not connect to it.
DATABASE_URL=
# RDS: absolute path to the AWS CA bundle; omit SSL URL parameters when set.
DATABASE_SSL_CA_FILE=
IETT_HISTORY_DELAY_MS=1000
IETT_HISTORY_TIMEOUT_MS=120000
